# copy to config.env, fill in, `source config.env`. Never commit config.env.
export MIXER_ROOT=/workspace/mixes          # repo root (scripts default to /workspace/mixes)
export HOST=homebox                         # ssh alias of the residential machine (yt-dlp + delivery)
export ICLOUD_DEST='Library/Mobile Documents/com~apple~CloudDocs/DJ Mixes'   # delivery folder on $HOST
export TAG_ARTIST='DJ Grok Bot'             # ID3 artist for delivered mixes
export OP_VAULT=MyVault                     # 1Password vault holding the credentials below
export OP_YT_CLIENT_ITEM='YouTube OAuth client'      # item: username=client_id, password=client_secret
export OP_YT_REFRESH_ITEM='YouTube refresh token'    # item: field "credential" = refresh token
export NUDGE=nudge60d.json                  # warp-nudge file used by mix3/guardrails
